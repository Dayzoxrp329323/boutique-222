        category:"Sport",
        emoji:"⌚",
        image:"",
        description:"Montre idéale pour vos activités."
    },
    {
        id:8,
        name:"Lunettes Nova",
        price:39.99,
        category:"Accessoires",
        emoji:"🕶️",
        image:"",
        description:"Lunettes modernes et légères."
    }
];

let cart = JSON.parse(localStorage.getItem("nova_cart")) || [];
let favorites = JSON.parse(localStorage.getItem("nova_favorites")) || [];
let sellerProducts =
    JSON.parse(localStorage.getItem("nova_seller_products")) || [];

let selectedCategory = "Tous";
let paymentMethod = "paypal";

function money(value){
    return value.toLocaleString("fr-FR",{
        style:"currency",
        currency:"EUR"
    });
}

function saveData(){

    localStorage.setItem(
        "nova_cart",
        JSON.stringify(cart)
    );

    localStorage.setItem(
        "nova_favorites",
        JSON.stringify(favorites)
    );

    localStorage.setItem(
        "nova_seller_products",
        JSON.stringify(sellerProducts)
    );
}

function getAllProducts(){
    return [...products,...sellerProducts];
}

function renderCategories(){

    const categories = [
        "Tous",
        ...new Set(
            getAllProducts().map(product=>product.category)
        )
    ];

    document.getElementById("categories").innerHTML =
        categories.map(category=>`

        <div class="category ${
            selectedCategory===category ? "active" : ""
        }"
        onclick="selectCategory('${category}')">

            ${category}

        </div>

        `).join("");
}

function selectCategory(category){

    selectedCategory = category;

    renderCategories();
    renderProducts();
}

function renderProducts(){

    const search =
        document.getElementById("searchInput")
        .value
        .toLowerCase();

    const sort =
        document.getElementById("sortSelect").value;

    let list = getAllProducts().filter(product=>{

        const matchesCategory =
            selectedCategory==="Tous" ||
            product.category===selectedCategory;

        const matchesSearch =
            product.name.toLowerCase().includes(search) ||
            product.category.toLowerCase().includes(search);

        return matchesCategory && matchesSearch;

    });

    if(sort==="priceLow"){
        list.sort((a,b)=>a.price-b.price);
    }

    if(sort==="priceHigh"){
        list.sort((a,b)=>b.price-a.price);
    }

    if(sort==="name"){
        list.sort((a,b)=>a.name.localeCompare(b.name));
    }

    const container =
        document.getElementById("products");

    if(!list.length){

        container.innerHTML =
            `<div class="empty">
                Aucun produit trouvé.
            </div>`;

        return;
    }

    container.innerHTML =
        list.map(product=>productHTML(product)).join("");
}

function productHTML(product){

    const isFavorite =
        favorites.includes(product.id);

    const visual =
        product.image
        ? `<img src="${escapeHTML(product.image)}" alt="">`
        : product.emoji;

    return `

    <div class="product">

        <div class="product-image">
            ${visual}
        </div>

        <div class="product-info">

            <div class="product-category">
                ${escapeHTML(product.category)}
            </div>

            <div class="product-name">
                ${escapeHTML(product.name)}
            </div>

            <p style="font-size:13px;color:#777080;margin-top:5px;">
                ${escapeHTML(product.description || "")}
            </p>

            <div class="product-bottom">

                <div class="price">
                    ${money(product.price)}
                </div>

                <button class="favorite"
                        onclick="toggleFavorite(${product.id})">

                    ${isFavorite ? "♥" : "♡"}

                </button>

                <button class="add"
                        onclick="addToCart(${product.id})">

                    Ajouter

                </button>

            </div>

        </div>

    </div>

    `;
}

function escapeHTML(value){

    return String(value ?? "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");
}

function addToCart(id){

    const product =
        getAllProducts().find(p=>p.id===id);

    if(!product) return;

    const existing =
        cart.find(item=>item.id===id);

    if(existing){
        existing.quantity++;
    }else{
        cart.push({
            id:id,
            quantity:1
        });
    }

    saveData();
    updateCart();
    showToast("Produit ajouté au panier !");
}

function removeFromCart(id){

    cart =
        cart.filter(item=>item.id!==id);

    saveData();
    renderCart();
    updateCart();
}

function changeQuantity(id,change){

    const item =
        cart.find(item=>item.id===id);

    if(!item) return;

    item.quantity += change;

    if(item.quantity<=0){
        removeFromCart(id);
        return;
    }

    saveData();
    renderCart();
    updateCart();
}

function getCartDetails(){

    return cart.map(item=>{

        const product =
            getAllProducts().find(p=>p.id===item.id);

        return {
            ...product,
            quantity:item.quantity
        };

    }).filter(Boolean);
}

function cartTotal(){

    return getCartDetails().reduce(
        (total,item)=>
            total + item.price*item.quantity,
        0
    );
}

function updateCart(){

    const count =
        cart.reduce(
            (sum,item)=>sum+item.quantity,
            0
        );

    document.getElementById("cartBadge")
        .textContent=count;
}

function renderCart(){

    const container =
        document.getElementById("cartItems");

    const items = getCartDetails();

    if(!items.length){

        container.innerHTML =
            `<div class="empty">
                Votre panier est vide 🛒
            </div>`;

    }else{

        container.innerHTML =
            items.map(item=>`

            <div class="cart-item">

                <div class="cart-image">
                    ${item.emoji}
                </div>

                <div class="cart-info">

                    <strong>
                        ${escapeHTML(item.name)}
                    </strong>

                    <div>
                        ${money(item.price)}
                    </div>

                    <div class="qty">

                        <button onclick="changeQuantity(${item.id},-1)">
                            −
                        </button>

                        <span>${item.quantity}</span>

                        <button onclick="changeQuantity(${item.id},1)">
                            +
                        </button>

                    </div>

                </div>

                <button class="btn btn-danger"
                        onclick="removeFromCart(${item.id})">
                    Supprimer
                </button>

            </div>

            `).join("");

    }

    document.getElementById("cartTotal")
        .textContent=money(cartTotal());
}

function openCart(){

    renderCart();

    document.getElementById("cartModal")
        .classList.add("show");
}

function openFavorites(){

    const list =
        getAllProducts().filter(
            product=>favorites.includes(product.id)
        );

    const container =
        document.getElementById("favoriteItems");

    if(!list.length){

        container.innerHTML =
            `<div class="empty">
                Aucun favori pour le moment ❤️
            </div>`;

    }else{

        container.innerHTML =
            list.map(product=>productHTML(product)).join("");

    }

    document.getElementById("favoriteModal")
        .classList.add("show");
}

function toggleFavorite(id){

    if(favorites.includes(id)){

        favorites =
            favorites.filter(
                favorite=>favorite!==id
            );

        showToast("Retiré des favoris");

    }else{

        favorites.push(id);

        showToast("Ajouté aux favoris ❤️");
    }

    saveData();
    renderProducts();
}

function openSeller(){

    renderSellerList();

    document.getElementById("sellerModal")
        .classList.add("show");
}

function addSellerProduct(){

    const name =
        document.getElementById("sellerName").value.trim();

    const price =
        Number(document.getElementById("sellerPrice").value);

    const category =
        document.getElementById("sellerCategory").value;

    const image =
        document.getElementById("sellerImage").value.trim();

    const description =
        document.getElementById("sellerDescription").value.trim();

    if(!name || !price || price<=0){

        showToast("Remplis le nom et le prix.");
        return;
    }

    const product = {

        id:Date.now(),

        name:name,

        price:price,

        category:category,

        image:image,

        emoji:"🛍️",

        description:
            description ||
            "Produit vendu sur Nova Boutique."

    };

    sellerProducts.push(product);

    saveData();

    document.getElementById("sellerName").value="";
    document.getElementById("sellerPrice").value="";
    document.getElementById("sellerImage").value="";
    document.getElementById("sellerDescription").value="";

    renderSellerList();
    renderCategories();
    renderProducts();

    showToast("Produit publié !");
}

function renderSellerList(){

    const container =
        document.getElementById("sellerList");

    if(!sellerProducts.length){

        container.innerHTML =
            `<p style="color:#777080;margin-top:10px;">
                Vous n'avez encore aucun produit.
            </p>`;

        return;
    }

    container.innerHTML =
        sellerProducts.map(product=>`

        <div class="seller-row">

            <div>

                <strong>
                    ${escapeHTML(product.name)}
                </strong>

                <br>

                <small>
                    ${money(product.price)}
                </small>

            </div>

            <button
                class="btn btn-danger"
                onclick="deleteSellerProduct(${product.id})">

                Supprimer

            </button>

        </div>

        `).join("");
}

function deleteSellerProduct(id){

    sellerProducts =
        sellerProducts.filter(
            product=>product.id!==id
        );

    cart =
        cart.filter(
            item=>item.id!==id
        );

    favorites =
        favorites.filter(
            favorite=>favorite!==id
        );

    saveData();

    renderSellerList();
    renderCategories();
    renderProducts();
    updateCart();

    showToast("Produit supprimé.");
}

function openCheckout(){

    if(!cart.length){

        showToast("Votre panier est vide.");
        return;
    }

    closeModal("cartModal");

    document.getElementById("checkoutTotal")
        .textContent=money(cartTotal());

    document.getElementById("checkoutModal")
        .classList.add("show");
}

function selectPayment(method){

    paymentMethod=method;

    document
        .getElementById("paypalMethod")
        .classList.toggle(
            "selected",
            method==="paypal"
        );

    document
        .getElementById("cardMethod")
        .classList.toggle(
            "selected",
            method==="card"
        );

    document
        .getElementById("cardForm")
        .classList.toggle(
            "hidden",
            method!=="card"
        );
}

function processPayment(){

    const firstName =
        document.getElementById("firstName").value.trim();

    const lastName =
        document.getElementById("lastName").value.trim();

    const email =
        document.getElementById("email").value.trim();

    const address =
        document.getElementById("address").value.trim();

    if(!firstName ||
       !lastName ||
       !email ||
       !address){

        showToast("Complète tes informations.");
        return;
    }

    /*
       IMPORTANT :

       Cette partie est une démonstration.

       Pour un vrai paiement :

       PayPal :
       créer une commande PayPal côté serveur,
       puis utiliser le SDK officiel PayPal.

       Carte bancaire :
       utiliser Stripe Checkout/Payment Element
       côté serveur.

       Ne mets JAMAIS une clé secrète Stripe
       ou PayPal directement dans ce fichier.
    */

    showToast(
        paymentMethod==="paypal"
        ? "Redirection vers PayPal..."
        : "Redirection vers le paiement sécurisé..."
    );

    setTimeout(()=>{

        const order = {

            id:"NOVA-"+Date.now(),

            customer:{
                firstName,
                lastName,
                email,
                address
            },

            items:getCartDetails(),

            total:cartTotal(),

            payment:paymentMethod,

            date:new Date().toISOString()

        };

        console.log("Commande :",order);

        cart=[];

        saveData();

        updateCart();

        closeModal("checkoutModal");

        showToast(
            "Commande créée avec succès !"
        );

    },1000);
}

function closeModal(id){

    document
        .getElementById(id)
        .classList.remove("show");
}

function showToast(message){

    const toast =
        document.getElementById("toast");

    toast.textContent=message;

    toast.classList.add("show");

    setTimeout(()=>{
        toast.classList.remove("show");
    },2500);
}

function scrollToShop(){

    document
        .getElementById("shop")
        .scrollIntoView({
            behavior:"smooth"
        });
}

document.querySelectorAll(".modal")
.forEach(modal=>{

    modal.addEventListener("click",event=>{

        if(event.target===modal){
            modal.classList.remove("show");
        }

    });

});

renderCategories();
renderProducts();
updateCart();

</script>

</body>
</html>
